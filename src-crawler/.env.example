# ==============================================================================
# VRC Packages (VRCP) - Crawler Node Environment Configuration Template
# Copy this file to .env and configure values before starting the node.
# ==============================================================================

# Required: Capability token issued by the coordinator (/v1/operator/nodes).
# Format: vrcp_<secret><capabilities>
NODE_TOKEN=vrcp_example_token_replace_with_coordinator_issued_token

# Required for Docker: Verified CI-built image digest or tag.
# Preview: ghcr.io/slamthedragon/vrcp-crawler-node-preview:latest
# Release: ghcr.io/slamthedragon/vrcp-crawler-node:latest
VRCP_NODE_IMAGE=ghcr.io/slamthedragon/vrcp-crawler-node-preview:latest

# Optional: Unique identifier for this crawler node instance (default: docker-node-1).
NODE_ID=docker-node-1

# Optional: Coordinator API base URL (default: https://vrcp-coordinator.workers.dev).
COORDINATOR_URL=https://vrcp-coordinator.workers.dev

# Optional: Platform capability filters (comma-separated: booth,github,vpm,gumroad,shopify).
# The coordinator token enforces actual authorized capabilities.
NODE_CAPABILITIES=booth,github,vpm,gumroad,shopify

# Optional: Path to SQLite database file.
# Defaults to /app/data/node.db in container, or node.db in the local working directory.
# NODE_DB_PATH=/app/data/node.db

# Optional: Scoped GitHub token to avoid API rate limits during GitHub metadata discovery.
# GITHUB_TOKEN=ghp_example
